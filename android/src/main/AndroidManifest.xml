<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    Only needed when the engine is configured for input. Playback and the
    generators need no permission at all, so this is declared with a feature
    requirement of false and requested at runtime by the host app.
  -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" />

  <uses-feature
    android:name="android.hardware.microphone"
    android:required="false" />

  <!--
    Low-latency output. Oboe picks AAudio where these are present and falls
    back to OpenSL ES otherwise; declaring them lets the Play Store surface
    the capability and lets Oboe choose the better path.
  -->
  <uses-feature
    android:name="android.hardware.audio.low_latency"
    android:required="false" />

  <uses-feature
    android:name="android.hardware.audio.pro"
    android:required="false" />

</manifest>
